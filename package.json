{
  "name": "spay-bienestar-api",
  "version": "1.0.0",
  "description": "API REST de Spay Bienestar — Semana 09: Testing (Jest + Supertest)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "test": "NODE_ENV=test jest --runInBand --forceExit",
    "test:watch": "NODE_ENV=test jest --watch --runInBand",
    "test:coverage": "NODE_ENV=test jest --coverage --runInBand --forceExit"
  },
  "dependencies": {
    "bcrypt": "5.1.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "5.1.0",
    "express-mongo-sanitize": "2.2.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.16.0",
    "morgan": "1.10.0",
    "winston": "3.17.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.9",
    "@types/morgan": "1.9.10",
    "@types/node": "22.15.21",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "mongodb-memory-server": "10.1.4",
    "supertest": "7.1.0",
    "ts-jest": "29.3.4",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
